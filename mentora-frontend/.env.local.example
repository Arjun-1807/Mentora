# Copy to .env.local and fill in.

# Backend base URL (used by the browser and by /api/send-email to verify the session).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Resend (https://resend.com/docs) — required for the "Send" button on /matches.
RESEND_API_KEY=
# Optional. Resend's shared test domain only delivers to your own Resend
# account address; verify a domain and set a sender on it to email real mentors.
# RESEND_FROM_EMAIL=Mentora <mentora@resend.dev>
