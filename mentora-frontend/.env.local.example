# Copy to .env.local and fill in.

# Backend base URL, used by the browser for every API call.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Email is sent by the backend (Gmail SMTP), not by this app: set GMAIL_USER and
# GMAIL_APP_PASSWORD (and optionally EMAIL_DELIVERY) in mentora-backend/.env.
# The frontend needs no email keys.
