GROQ_API_KEY=
MONGODB_URI=

# Required: secret used to sign JWT access tokens. Must be at least 32
# characters; the app refuses to start if it is missing or weak.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Optional overrides (defaults shown)
# GROQ_MODEL=openai/gpt-oss-20b
# MONGODB_DB_NAME=mentora
# MONGODB_MENTORS_COLLECTION=mentors
# MONGODB_MATCHES_COLLECTION=matches
# MONGODB_FEEDBACK_COLLECTION=feedback
# MONGODB_USERS_COLLECTION=users
# MONGODB_VECTOR_INDEX_NAME=mentor_vector_index
# EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
# EMBEDDING_DIMENSIONS=768
# FRONTEND_ORIGIN=http://localhost:3000

# Auth
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=1440

# Uploads
# MAX_UPLOAD_BYTES=10485760          # 10 MB cap on /extract PDF uploads

# Rate limiting (in-process; a multi-process deployment needs Redis instead)
# RATE_LIMIT_ENABLED=true
# LOGIN_RATE_LIMIT=10                # login attempts per window, per client IP
# LOGIN_RATE_WINDOW_SECONDS=300
# LLM_RATE_LIMIT=20                  # /extract + /email calls per window, per user
# LLM_RATE_WINDOW_SECONDS=3600
