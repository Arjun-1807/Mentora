GROQ_API_KEY=
MONGODB_URI=

JWT_SECRET=

# Google Calendar (OAuth 2.0 "Web application" client; see README).
# Leave the id/secret empty to disable the /calendar endpoints (503).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/calendar/callback
CALENDAR_TIMEZONE=Asia/Kolkata

# Email (intro requests + accept/decline notifications), sent by the backend
# through Gmail SMTP with a Google App Password (see README "Email").
# Without both values, email runs in "log" mode: nothing is sent and each
# message is only recorded in the `outbox` collection.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# EMAIL_DELIVERY=                    # smtp | log; empty = smtp if Gmail is set, else log
# EMAIL_FROM_NAME=Mentora
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Optional overrides (defaults shown)
# GROQ_MODEL=openai/gpt-oss-20b
# MONGODB_DB_NAME=mentora
# MONGODB_MENTORS_COLLECTION=mentors
# MONGODB_MATCHES_COLLECTION=matches
# MONGODB_FEEDBACK_COLLECTION=feedback
# MONGODB_USERS_COLLECTION=users
# MONGODB_OAUTH_STATES_COLLECTION=oauth_states
# MONGODB_MEETING_NOTES_COLLECTION=meeting_notes
# OAUTH_STATE_TTL_SECONDS=900        # how long a Google OAuth state stays valid
# MONGODB_VECTOR_INDEX_NAME=mentor_vector_index
# EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
# EMBEDDING_DIMENSIONS=768
# FRONTEND_ORIGIN=http://localhost:3000

# Auth
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=1440

# Uploads
# MAX_UPLOAD_BYTES=10485760          # 10 MB cap on /extract PDF uploads

# Rate limiting (in-process; a multi-process deployment needs Redis instead)
# RATE_LIMIT_ENABLED=true
# LOGIN_RATE_LIMIT=10                # login attempts per window, per client IP
# LOGIN_RATE_WINDOW_SECONDS=300
# LLM_RATE_LIMIT=20                  # /extract + /email calls per window, per user
# LLM_RATE_WINDOW_SECONDS=3600
# MATCH_REQUEST_RATE_LIMIT=10        # POST /matches/{id}/request per window, per user
# MATCH_REQUEST_RATE_WINDOW_SECONDS=3600

# Match lifecycle
# MATCH_REQUEST_TTL_DAYS=7           # unanswered requests expire (checked when matches are listed)
