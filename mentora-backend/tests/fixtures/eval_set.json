{
  "version": 1,
  "description": "Offline evaluation set for mentor matching (scripts/eval_matching.py). SYNTHETIC labels written by the developer, not by incubator coordinators: use them to compare ranking changes against each other, not as a measure of real-world match quality. Replace/extend with coordinator-graded labels once a pilot runs.",
  "judged_mentors_note": "Labels cover only the 15 seeded mentors (seed_mentors.py, fake @mentors.mentora.dev emails). Mentors outside this list (real accounts created through /register) are UNJUDGED: the eval script removes them from the ranking before computing metrics (condensed-list evaluation), so the numbers do not depend on which real accounts happen to exist in the database.",
  "rubric": {
    "inputs": "Per profile the labeller hand-assigns judged_sectors (seed-domain vocabulary; synonyms such as D2C=E-commerce, InsurTech=Fintech, DeepTech robotics=AI/ML resolved by judgement) and need_tags: which of the seed expertise areas the startup's challenges/team gaps actually call for. Labels use only the seed mentors' domain, stage_focus and expertise as they were BEFORE the Phase 4 changes (no skills field), so later changes to the seed data cannot leak into the labels.",
    "definitions": {
      "stage_distance": "0 = same stage, 1 = adjacent (idea-MVP, MVP-growth), 2 = idea-growth",
      "N": "number of the mentor's expertise areas that appear in need_tags"
    },
    "grade_2": "highly relevant: sector fit AND ((stage_distance 0 AND N >= 1) OR (stage_distance 1 AND N >= 2))",
    "grade_1": "partially relevant: any other sector-fit mentor; OR no sector fit but N >= 2 and stage_distance <= 1",
    "grade_0": "not relevant: everything else (omitted from `relevance`)",
    "overrides": "a few rubric outputs were changed by hand; each carries a reason in label_overrides",
    "metrics": "P@5 counts grade >= 1 as relevant; MRR uses the first grade-2 mentor (grade >= 1 if a profile has no grade-2 mentor); nDCG@5 uses gain 2^grade - 1"
  },
